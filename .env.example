# Planning Center OAuth credentials
# Register your OAuth app at https://api.planningcenteronline.com/oauth/applications
PCO_CLIENT_ID=your_planning_center_client_id
PCO_CLIENT_SECRET=your_planning_center_client_secret

# NextAuth configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
